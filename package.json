{
  "name": "touchline",
  "private": true,
  "version": "0.1.0",
  "description": "Spin the wheel. Draft the XI. Manage the season. A web football game fusing 38-0's spin-and-draft with Football Manager's depth.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -b --noEmit",
    "check:dist-keys": "node scripts/online/check-dist-keys.mjs dist",
    "sql:test": "bash scripts/online/sql/run-local.sh",
    "build:verifier": "node scripts/online/build-verifier.mjs",
    "check:verifier": "node scripts/online/check-verifier.mjs --no-build",
    "deploy:function": "node scripts/online/deploy-function.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.3",
    "immer": "^11.2.9",
    "lz-string": "1.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "esbuild": "0.25.12",
    "typescript": "~5.8.3",
    "vite": "^6.3.5",
    "vitest": "^3.2.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
